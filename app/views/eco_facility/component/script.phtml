<script>
    new DataTable('#example', {
        ajax: "<?= BASE_URL ?>/eco-facility/datatable",
        processing: true,
        serverSide: true
    });

    $('.dt-input').addClass('form-control rounded border-secondary');

    document.addEventListener('click', function(event) {
        if (event.target.classList.contains('delete-button')) {
            const facilityId = event.target.getAttribute('data-id');
            if (confirm('Are you sure you want to delete this eco facility?')) {
                fetch(`<?= BASE_URL ?>/eco-facility/facility/${facilityId}`, {
                        method: 'DELETE'
                    })
                    .then(response => response.json().then(data => {
                        if (data.success) {
                            location.reload(); // Reload the page to see the updated list
                        } else {
                            alert(data.error || 'Error deleting eco facility.');
                        }
                    }))
                    .catch(error => {
                        console.error('Error:', error);
                        alert('An error occurred while deleting the eco facility.');
                    });
            }
        }


        if (event.target.classList.contains('visit-button')) {
            const facilityId = event.target.getAttribute('data-id');
            markAsVisited(facilityId, event.target);
        }
    });
</script>


<script>
    let currentPage = 1;
    let isLoading = false;
    let hasMore = true;
    const container = document.getElementById('eco-container');
    const loading = document.getElementById('loading');
    let facilityMap = null;
    let mapMarker = null;

    const mapModal = document.getElementById('mapModal');
    const closeModal = document.getElementById('closeModal');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const facilityTitle = document.getElementById('facilityTitle');
    const facilityAddress = document.getElementById('facilityAddress');
    const facilityCoordinates = document.getElementById('facilityCoordinates');

    const alertContainer = document.getElementById('alertContainer');
    const alertMessage = document.getElementById('alertMessage');

    loadData();

    document.getElementById('search').addEventListener('keyup', function() {
        const searchValue = this.value;
        currentPage = 1;
        loadData(searchValue);
    });

    window.addEventListener('scroll', function() {
        if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight) {
            if (!isLoading && hasMore) {
                currentPage++;
                loadData();
            }
        }
    });

    closeModal.addEventListener('click', () => {
        mapModal.style.display = 'none';
    });

    closeModalBtn.addEventListener('click', () => {
        mapModal.style.display = 'none';
    });

    window.addEventListener('click', (event) => {
        if (event.target === mapModal) {
            mapModal.style.display = 'none';
        }
    });


    document.querySelector('.btn-close').addEventListener('click', () => {
        alertContainer.style.display = 'none';
    });

    async function loadData(search = '') {
        isLoading = true;
        // loading.style.display = 'block';

        try {
            const response = await fetch(
                `<?= BASE_URL ?>/eco-facility/datatable?page=${currentPage}&search=${search}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                }
            );

            const {
                data,
                total,
                has_more
            } = await response.json();
            renderData(data);
            hasMore = has_more;

        } catch (error) {
            console.error('Error loading data:', error);
            Swal.fire({
                title: "Error",
                text: "An error occured while loading data. Please try again later",
                icon: "error"
            });
        } finally {
            isLoading = false;
            // loading.style.display = 'none';
        }
    }

    function renderData(data) {
        if(currentPage == 1) {
            container.innerHTML = ''
            if(data.length < 1) {
                const notFoundRow = document.createElement('tr');
                notFoundRow.innerHTML = `
                    <td colspan="7" class="text-center">No facilities found.</td>
                `;
                container.appendChild(notFoundRow);
            }
        }
        data.forEach(facility => {
            const row = document.createElement('tr');

            row.innerHTML = `
                <td>${facility.title}</td>
                <td>${facility.description}</td>
                <td>${facility.category}</td>
                <td>${facility.town}</td>
                <td>${facility.county}</td>
                <td>${facility.postcode}</td>
                <td>
                    <div class="btn-group text-nowrap">
                        <a href="<?= BASE_URL ?>/eco-facility/detail/${facility.id}" class="btn btn-info btn-sm">
                            <i class="fas fa-map-marker-alt"></i> View Details
                        </a>
                        ${generateActionButtons(facility)}
                    </div>
                </td>
            `;

            container.appendChild(row);
        });
    }

    function formatAddress(facility) {
        let address = [];
        if (facility.houseNumber) address.push(facility.houseNumber);
        if (facility.streetName) address.push(facility.streetName);
        if (facility.town) address.push(facility.town);
        if (facility.county) address.push(facility.county);
        if (facility.postcode) address.push(facility.postcode);

        return address.join(', ');
    }

    function generateActionButtons(facility) {
        let buttons = '';

        <?php if (isset($_SESSION['user_role'])) { ?>
            if ('<?= $_SESSION['user_role'] ?>' === 'Manager') {
                buttons += `
                <a href="<?= BASE_URL ?>/eco-facility/edit/${facility.id}" 
                   class="btn btn-warning btn-sm">Edit</a>
                <button class="btn btn-danger btn-sm delete-button" 
                        data-id="${facility.id}">Delete</button>
            `;
            }

            if ('<?= $_SESSION['user_role'] ?>' === 'User') {
                if (facility.isVisited) {
                    buttons += `<button class="btn btn-primary btn-sm" disabled>Visited</button>`;
                } else {
                    buttons += `
                    <button class="btn btn-primary btn-sm visit-button" 
                            data-id="${facility.id}">Mark Visited</button>
                `;
                }
            }
        <?php } ?>

        return buttons;
    }

    function showLocationModal(event) {
        const button = event.currentTarget;
        const facilityId = button.getAttribute('data-id');
        const title = button.getAttribute('data-title');
        const lat = parseFloat(button.getAttribute('data-lat'));
        const lng = parseFloat(button.getAttribute('data-lng'));
        const address = button.getAttribute('data-address');

        <?php if (!isset($_SESSION['user_role'])) { ?>
            Swal.fire({
                title: "Warning",
                text: "Please login to view the location map",
                icon: "warning"
            });
            return;
        <?php } ?>

        if (isNaN(lat) || isNaN(lng) || (lat === 0 && lng === 0)) {
            Swal.fire({
                title: "Warning",
                text: "Location coordinates are not available for this facility",
                icon: "warning"
            });
            return;
        }

        facilityTitle.textContent = title;
        facilityAddress.textContent = address;
        facilityCoordinates.textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;

        try {
            if (!facilityMap) {
                facilityMap = L.map('facilityMap').setView([lat, lng], 15);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                }).addTo(facilityMap);

                mapMarker = L.marker([lat, lng]).addTo(facilityMap);
            } else {
                facilityMap.setView([lat, lng], 15);
                mapMarker.setLatLng([lat, lng]);
            }

            mapModal.style.display = 'block';

            setTimeout(() => {
                facilityMap.invalidateSize();
            }, 100);
        } catch (error) {
            console.error('Error loading map:', error);
            Swal.fire({
                title: "Error",
                text: "An error occurred while loading the map. Please try again later.",
                icon: "error"
            });
        }
    }

    container.addEventListener('click', function(e) {
        if (e.target.classList.contains('delete-button') ||
            e.target.parentElement.classList.contains('delete-button')) {
            const button = e.target.classList.contains('delete-button') ?
                e.target : e.target.parentElement;
            const facilityId = button.getAttribute('data-id');

            if (confirm('Are you sure you want to delete this eco facility?')) {
                deleteFacility(facilityId, button.closest('tr'));
            }
        }

        if (e.target.classList.contains('visit-button') ||
            e.target.parentElement.classList.contains('visit-button')) {
            const button = e.target.classList.contains('visit-button') ?
                e.target : e.target.parentElement;
            const facilityId = button.getAttribute('data-id');
            markAsVisited(facilityId, button);
        }
    });

    async function deleteFacility(facilityId, rowElement) {
        try {
            const response = await fetch(`<?= BASE_URL ?>/eco-facility/facility/${facilityId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            const result = await response.json();

            if (result.success) {
                rowElement.remove();
                Swal.fire({
                    title: "Success",
                    text: result.success,
                    icon: "success",
                });
            } else {
                Swal.fire({
                    title: "Error",
                    text: result.error || 'An error occurred while deleting the facility',
                    icon: "error",
                });
            }
        } catch (error) {
            console.error('Error deleting facility:', error);
            Swal.fire({
                title: "Error",
                text: "An error occurred while trying to delete the facility",
                icon: "error",
            });
        }
    }

    async function markAsVisited(facilityId, buttonElement) {
        try {
            Swal.fire({
                title: "Mark Facility as Visited",
                text: "Would you like to add a comment about your visit?",
                input: "textarea",
                inputPlaceholder: "Share your experience (optional)",
                inputAttributes: {
                    autocapitalize: "off"
                },
                showCancelButton: true,
                confirmButtonText: "Mark as Visited",
                showLoaderOnConfirm: true,
                preConfirm: async (comment) => {
                    try {
                        const response = await fetch(`<?= BASE_URL ?>/eco-facility/visit/${facilityId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                comment: comment
                            })
                        });

                        if (!response.ok) {
                            return Swal.showValidationMessage(`Request failed: ${response.status}`);
                        }
                        return response.json();
                    } catch (error) {
                        return Swal.showValidationMessage(`Request failed: ${error}`);
                    }
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed) {
                    if (result.value.success) {
                        buttonElement.textContent = 'Visited';
                        buttonElement.disabled = true;
                        buttonElement.classList.remove('visit-button');
                        Swal.fire({
                            title: "Success",
                            text: "Facility marked as visited successfully!",
                            icon: "success",
                        });
                    } else {
                        Swal.fire({
                            title: "Error",
                            text: result.value.error || 'Error marking facility as visited',
                            icon: "error",
                        });
                    }
                }
            });
        } catch (error) {
            console.error('Error marking facility as visited:', error);
            Swal.fire({
                title: "Error",
                text: "An error occurred while trying to mark the facility as visited",
                icon: "error",
            });
        }
    }
</script>