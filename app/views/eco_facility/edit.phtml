<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var map = L.map('map').setView([<?= $ecoFacility['lat'] ?? '51.505' ?>, <?= $ecoFacility['lng'] ?? '-0.09' ?>], 13);
        var marker;

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        function updateMarkerPosition(lat, lng) {
            document.getElementById('lat').value = lat.toFixed(6);
            document.getElementById('lng').value = lng.toFixed(6);

            if (marker) {
                marker.setLatLng([lat, lng]);
            } else {
                marker = L.marker([lat, lng], {
                    draggable: true
                }).addTo(map);
                marker.on('dragend', function(e) {
                    var pos = marker.getLatLng();
                    updateMarkerPosition(pos.lat, pos.lng);
                });
            }

            map.setView([lat, lng], 15);
        }

        if (<?= isset($ecoFacility['lat']) && isset($ecoFacility['lng']) ? 'true' : 'false' ?>) {
            updateMarkerPosition(<?= $ecoFacility['lat'] ?? '51.505' ?>, <?= $ecoFacility['lng'] ?? '-0.09' ?>);
        }

        map.on('click', function(e) {
            updateMarkerPosition(e.latlng.lat, e.latlng.lng);
        });

        document.getElementById('getLocation').addEventListener('click', function() {
            var statusElement = document.getElementById('locationStatus');
            statusElement.textContent = "Getting location...";

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    var lat = position.coords.latitude;
                    var lng = position.coords.longitude;
                    updateMarkerPosition(lat, lng);
                    statusElement.textContent = "Location found!";
                    statusElement.style.color = "green";

                    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`)
                        .then(res => res.json())
                        .then(data => {
                            if (data.address) {
                                if (data.address.house_number) document.getElementById('houseNumber').value = data.address.house_number;
                                if (data.address.road) document.getElementById('streetName').value = data.address.road;
                                if (data.address.city || data.address.town || data.address.village)
                                    document.getElementById('town').value = data.address.city || data.address.town || data.address.village;
                                if (data.address.country) document.getElementById('county').value = data.address.country;
                                if (data.address.postcode) document.getElementById('postcode').value = data.address.postcode;
                            }
                        }).catch(error => console.error("Address lookup error:", error));
                }, function(error) {
                    statusElement.textContent = "Error: " + error.message;
                    statusElement.style.color = "red";
                }, {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                });
            } else {
                statusElement.textContent = "Geolocation not supported";
                statusElement.style.color = "red";
            }
        });

        setTimeout(() => map.invalidateSize(), 100);
    });
</script>